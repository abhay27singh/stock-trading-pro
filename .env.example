# Copy this file to .env and fill in REAL values. .env is gitignored — never commit it.
# start-all.sh loads .env and refuses to start if a required secret is empty.

# --- Database ---
# Each Spring service targets its OWN database (market_db / auth_db / trading_db)
# via its application.properties default, so DO NOT set a single shared DB_URL here
# or all three services will collide on one database.
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# --- JWT (shared HMAC secret across all services; HS256 needs >= 32 bytes) ---
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_bytes
JWT_EXPIRATION=86400000

# --- Service-to-service (internal wallet) shared key ---
INTERNAL_API_KEY=change_me_to_a_long_random_string

# --- Python market-data + prediction service ---
PREDICTION_SERVICE_URL=http://localhost:5001
MARKET_POLL_RATE=10000

CORS_ALLOWED_ORIGINS=http://localhost:3002
