# Build output (all Maven services + frontend)
**/target/
*.jar
frontend/node_modules/
frontend/build/

# Python
python/venv/
python/__pycache__/
python/*.pyc
python/*.pyo
*.egg-info/

# Logs & temp (runtime only)
logs/
*.log
*.tmp

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Env files (never commit real secrets)
.env
.env.local
.env.production

# Claude Code
.claude/

# NOTE: the Maven wrapper (mvnw, mvnw.cmd, .mvn/) IS committed on purpose,
# so anyone can build the Spring services without installing Maven.
